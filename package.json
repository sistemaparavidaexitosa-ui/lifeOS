{
  "name": "lifeos-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test:unit": "node --experimental-strip-types --test tests/domain/*.test.ts",
    "gen:types": "supabase gen types typescript --linked > src/types/database.types.ts",
    "gen:types:local": "supabase gen types typescript --local > src/types/database.types.ts",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "migrar": "supabase db push",
    "db:test": "supabase test db",
    "verify": "pnpm install --frozen-lockfile && pnpm typecheck && pnpm lint && pnpm test:unit && pnpm build && supabase db reset && supabase db test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.120.0",
    "@supabase/ssr": "0.5.2",
    "@supabase/supabase-js": "2.47.10",
    "clsx": "2.1.1",
    "next": "15.5.23",
    "openai": "7.8.0",
    "react": "19.1.2",
    "react-dom": "19.1.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@types/node": "24.13.3",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.20",
    "eslint": "9.18.0",
    "eslint-config-next": "15.5.23",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  }
}
