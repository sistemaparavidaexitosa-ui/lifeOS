# Dónde vive LifeOS y con qué secreto se le pide el contexto.
LIFEOS_BASE_URL=http://localhost:3000
LIFEOS_AGENT_SECRET=el-mismo-valor-que-MANIFESTATION_AGENT_SECRET-en-lifeos

# El secreto que ESTE servicio exige a quien le llama. Puede coincidir con el
# anterior en una instalación pequeña, pero se declara aparte porque protege la
# dirección contraria: rotar uno no debería obligar a rotar el otro.
AGENT_INBOUND_SECRET=el-mismo-valor-que-MANIFESTATION_AGENT_SECRET-en-lifeos

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

AGENT_MAX_OUTPUT_TOKENS=8000
AGENT_THINKING_BUDGET=2048
AGENT_TIMEOUT_S=45
LIFEOS_TIMEOUT_S=10

AGENT_VERSION=1.0.0
LOG_LEVEL=INFO
