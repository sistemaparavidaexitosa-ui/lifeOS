# Copia este archivo a .env.local. Los valores de abajo son los de la pila
# local de Supabase en Docker (`npx supabase start`): son idénticos en
# cualquier máquina y NO son secretos. Para un proyecto real, sustitúyelos por
# los de Supabase → Project Settings → API (ver /docs/DEPLOY.md).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Solo servidor. Nunca con prefijo NEXT_PUBLIC_. Se exige de forma perezosa
# (src/config/env.ts) y únicamente en las acciones que saltan RLS a propósito.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Life OS
NEXT_PUBLIC_DEFAULT_LOCALE=es-MX
NEXT_PUBLIC_DEFAULT_CURRENCY=MXN

# OPCIONAL. Solo mejora el buscador de metadatos de libros (§5.1): sin llave,
# Google Books responde contra una cuota anónima compartida que suele estar
# agotada (429). Open Library, que es el proveedor primario, no pide nada.
# GOOGLE_BOOKS_API_KEY=AIza...

# La ÚNICA llave de IA. La usan las tres funciones que llaman al modelo —el
# motor de recomendaciones (Intelligence OS), "Generar plan con IA" en
# /execution y el chat del rail lateral— y nadie más: sin ella el resto de la
# app funciona igual y esas tres avisan de que no están configuradas.
#
# Se saca gratis en https://aistudio.google.com/apikey. El free tier tiene
# límite por minuto y por día; las tres funciones son de una llamada por
# gesto del usuario, así que da de sobra. Al topar, el aviso lo dice con esas
# palabras y no como un error.
# GEMINI_API_KEY=AIza...

# Opcional. Buscador de alimentos genéricos (USDA FoodData Central) del módulo
# de Nutrición. Gratis en https://fdc.nal.usda.gov/api-key-signup. Sin ella se
# busca solo en Open Food Facts, que no pide llave.
# USDA_API_KEY=

# Solo para enviar invitaciones por correo (FR-WSP-003). Sin esta variable el
# resto de la app funciona; la acción de invitar es la única que la exige.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=LifeOS <onboarding@resend.dev>

# Solo para las notificaciones push (que el teléfono suene con la app cerrada).
# Se generan UNA VEZ con `node scripts/generate-vapid.mjs`, que las imprime ya
# con el formato de abajo. Sin ellas la app funciona entera y las
# notificaciones simplemente no salen: `sendPush` nunca lanza.
#
# VAPID_PRIVATE_JWK es un SECRETO. Cambiarlo invalida TODAS las suscripciones
# existentes y cada teléfono tiene que volver a activar el permiso.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_JWK=
# VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# Lo único que protege /api/push/dispatch, que corre SIN sesión porque quien lo
# invoca es pg_cron desde la base y no un navegador. Cualquier cadena larga y
# aleatoria sirve: `openssl rand -base64 32`. En Supabase se guarda además en
# Vault, nunca en el .sql de la migración (ver /docs/DEPLOY.md).
# PUSH_DISPATCH_SECRET=
